# ---------------------------------------------------------------------------
# Identity verification (https://verify.resukisu.org)
# ---------------------------------------------------------------------------
# Origin of the ghssh-compatible verifier. Override only to point at a
# different deployment of https://github.com/originalFactor/ghssh.
GHSSH_ORIGIN=https://verify.resukisu.org

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# HMAC key for session cookies. REQUIRED in production.
#   openssl rand -base64 48
SESSION_SECRET=

# Public origin of this deployment. Required when the app is not behind a
# proxy that sets x-forwarded-host (Vercel does, so it can be omitted there).
#   APP_ORIGIN=https://resuki-nic.vercel.app
APP_ORIGIN=

# Session lifetime in seconds (default 604800 = 7 days).
SESSION_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Key/value store (Vercel KV / Upstash Redis REST)
# ---------------------------------------------------------------------------
# Without these the app falls back to an in-process Map in development and
# refuses to start in production. Vercel KV injects KV_REST_API_* names;
# Upstash's own integration injects UPSTASH_REDIS_REST_*. Either works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 to allow the in-memory store in production (NOT recommended: state
# is per-instance and lost on every deploy).
ALLOW_MEMORY_STORE=

# ---------------------------------------------------------------------------
# Cloudflare (DNS delegation)
# ---------------------------------------------------------------------------
# Token needs Zone:DNS:Edit on both zones and Zone:Zone:Read so the app can
# look zone ids up by name.
#   https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# The zone that holds the delegations. Both suffixes live inside it as
# <label>.verified.<CF_ZONE> and <label>.contrib.<CF_ZONE>, so NS records go
# into this single zone. (Making verified.resukisu.org its own zone would
# require Cloudflare's Enterprise-only "subdomain setup".)
CF_ZONE=resukisu.org

# Override the API base; only useful for pointing at a local stub.
CF_API_BASE=

# ---------------------------------------------------------------------------
# GitHub (contributor checks)
# ---------------------------------------------------------------------------
# Optional but strongly recommended: unauthenticated GitHub API calls are
# limited to 60/hour per IP, authenticated ones to 5000/hour. A classic token
# with no scopes is enough for public repository data.
GITHUB_TOKEN=

# Repository whose contributors may register *.contrib.resukisu.org.
CONTRIBUTOR_REPO=Baka-SU/BakaSU

# How long a contributor lookup is cached, in seconds (default 3600).
CONTRIBUTOR_CACHE_SECONDS=

# Override the API base; only useful for pointing at a local stub.
GITHUB_API_BASE=

# ---------------------------------------------------------------------------
# DNS resolution (availability checks)
# ---------------------------------------------------------------------------
# Resolvers used to detect names already delegated outside our zones.
# Defaults to 1.1.1.1,8.8.8.8.
DNS_RESOLVERS=

# ---------------------------------------------------------------------------
# Rate limits (fixed window; per IP or per account)
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_START=20
RATE_LIMIT_LOGIN_START_WINDOW=600
RATE_LIMIT_AUTH_CALLBACK=10
RATE_LIMIT_AUTH_CALLBACK_WINDOW=300
RATE_LIMIT_DOMAIN_CHECK=120
RATE_LIMIT_DOMAIN_CHECK_WINDOW=600
RATE_LIMIT_DOMAIN_CREATE=10
RATE_LIMIT_DOMAIN_CREATE_WINDOW=3600
